---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
}

const {
  title,
  description,
  bodyClass = '',
  socialImage = `${import.meta.env.BASE_URL}dmi-logo.jpg`,
  socialImageAlt = 'DMI church logo',
  socialImageWidth = 900,
  socialImageHeight = 900,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(socialImage, Astro.site);
const twitterCard = socialImageWidth / socialImageHeight >= 1.5 ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#064a61" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={socialImageWidth.toString()} />
    <meta property="og:image:height" content={socialImageHeight.toString()} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}dmi-logo.jpg`} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
