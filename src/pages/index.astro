---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const base = import.meta.env.BASE_URL;
const studyPath = `${base}2026-08-30-taking-part-in-the-great-commission/`;
const previousStudyPath = `${base}2026-08-23-your-labor-is-not-in-vain/`;
const familyStudyPath = `${base}2026-08-16-altar-of-our-family/`;
const obedienceStudyPath = `${base}2026-08-09-altar-of-obedience/`;
const firstStudyPath = `${base}2026-08-02-altar-undivided-heart/`;
const songsPath = `${base}songs/`;
const logoPath = `${base}dmi-logo.jpg`;
---

<BaseLayout
  title="DMI Calamba City"
  description="DMI Calamba City is a church co-laboring with God to transform lives, communities and nations."
  bodyClass="home-page"
  socialImage={`${base}dmi-calamba-social-preview.jpg`}
  socialImageAlt="DMI Calamba — Grow Deeper in God's Word. Read our devotions."
  socialImageWidth={1280}
  socialImageHeight={720}
>
  <main>
    <section class="home-shell" aria-labelledby="site-title">
      <div class="home-glow" aria-hidden="true"></div>

      <header class="home-topbar">
        <span class="brand-lockup">
          <img src={logoPath} width="900" height="900" alt="DMI church logo" />
          <span>Calamba City</span>
        </span>
        <span>God. Family. Nations.</span>
      </header>

      <div class="home-title">
        <p class="home-kicker">Welcome to</p>
        <h1 id="site-title"><span>DMI</span> <span>Calamba City</span></h1>
        <p class="home-mission">We are a church <span>co-laboring with God</span> to transform lives, communities and nations.</p>
      </div>

      <footer class="home-footer">
        <div class="home-feature-links">
          <a class="study-link" href={studyPath}>
            <span class="study-link-label">Latest Bible Study</span>
            <span class="study-link-title">Taking Part in the Great Commission</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="study-link" href={songsPath}>
            <span class="study-link-label">DMI Calamba Worship</span>
            <span class="study-link-title">Listen to our songs</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="home-footer-meta">
          <p>Gathered around Jesus. Formed by his Word.</p>
          <SocialLinks />
        </div>
      </footer>
    </section>

    <section class="home-about" aria-labelledby="home-about-title">
      <div class="home-about-intro">
        <p class="section-number">A church in Calamba City</p>
        <h2 id="home-about-title">A place to follow Jesus together.</h2>
        <p>DMI Calamba City is a Christian church co-laboring with God to transform lives, communities and nations.</p>
      </div>
      <div class="home-about-grid">
        <article class="home-info-card">
          <span>Visit</span>
          <h3>Gather with us</h3>
          <address>3rd floor, AS Building, Crossing, Brgy. 1, Calamba City</address>
          <a href="https://www.facebook.com/DMICalamba" target="_blank" rel="noreferrer">See church updates <span aria-hidden="true">↗</span></a>
        </article>
        <article class="home-info-card">
          <span>Connect</span>
          <h3>We would love to hear from you</h3>
          <p>Questions, prayer requests, or looking for a church family?</p>
          <a href="mailto:dmicalamba@gmail.com">dmicalamba@gmail.com <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </section>

    <section class="home-studies" aria-labelledby="home-studies-title">
      <header class="home-studies-intro">
        <p class="section-number">Bible studies</p>
        <h2 id="home-studies-title">Study the Word with us.</h2>
        <p>Read the latest teaching or revisit an earlier study in English or Taglish.</p>
      </header>

      <ol class="home-study-list">
        <li>
          <a href={studyPath}>
            <time datetime="2026-08-30">30 August 2026</time>
            <span class="home-study-copy">
              <strong>Taking Part in the Great Commission</strong>
              <small>The Believer’s Assignment</small>
            </span>
            <span class="home-study-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={previousStudyPath}>
            <time datetime="2026-08-23">23 August 2026</time>
            <span class="home-study-copy">
              <strong>Your Labor Is Not in Vain</strong>
              <small>Serving the Lord with a Pure Heart</small>
            </span>
            <span class="home-study-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={familyStudyPath}>
            <time datetime="2026-08-16">16 August 2026</time>
            <span class="home-study-copy">
              <strong>Altar of Our Family</strong>
              <small>Making Jesus the Lord of Our Home</small>
            </span>
            <span class="home-study-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={obedienceStudyPath}>
            <time datetime="2026-08-09">09 August 2026</time>
            <span class="home-study-copy">
              <strong>Altar of Obedience</strong>
              <small>Trusting God Enough to Obey</small>
            </span>
            <span class="home-study-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={firstStudyPath}>
            <time datetime="2026-08-02">02 August 2026</time>
            <span class="home-study-copy">
              <strong>Altar of the Heart</strong>
              <small>An Undivided Heart for God</small>
            </span>
            <span class="home-study-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ol>
    </section>
  </main>
</BaseLayout>
