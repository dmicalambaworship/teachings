---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const base = import.meta.env.BASE_URL;
const studyPath = `${base}2026-08-02-altar-undivided-heart/`;
const logoPath = `${base}dmi-logo.jpg`;
---

<BaseLayout
  title="DMI Calamba City"
  description="Bible study resources from DMI Calamba City."
  bodyClass="home-page"
>
  <main class="home-shell">
    <div class="home-glow" aria-hidden="true"></div>

    <header class="home-topbar">
      <span class="brand-lockup">
        <img src={logoPath} width="900" height="900" alt="DMI church logo" />
        <span>Calamba City</span>
      </span>
      <span>Discipleship · Mission · Identity</span>
    </header>

    <section class="home-title" aria-labelledby="site-title">
      <p class="home-kicker">Welcome to</p>
      <h1 id="site-title"><span>DMI</span> <span>Calamba City</span></h1>
    </section>

    <footer class="home-footer">
      <a class="study-link" href={studyPath}>
        <span class="study-link-label">Latest Bible Study</span>
        <span class="study-link-title">Altar of the Heart</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <div class="home-footer-meta">
        <p>Gathered around Jesus. Formed by his Word.</p>
        <SocialLinks />
      </div>
    </footer>
  </main>
</BaseLayout>
