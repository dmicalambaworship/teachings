const base = import.meta.env.BASE_URL;
const pagePath = `${base}2026-09-27-contending-for-jesus-in-our-lives/`;
const pageURL = new URL(pagePath, Astro.site ?? Astro.url).toString();
const coverPath = `${base}2026-09-27-contending-for-jesus-in-our-lives-cover.jpg`;
const coverWebp1280 = `${base}2026-09-27-contending-for-jesus-in-our-lives-cover-1280.webp`;
const coverWebp2400 = `${base}2026-09-27-contending-for-jesus-in-our-lives-cover-2400.webp`;
const logoPath = `${base}dmi-logo.jpg`;
const qrPath = `${base}qr/2026-09-27-contending-for-jesus-in-our-lives.png`;

const translations = {
  languageLabel: `Wika`,
  languageAriaLabel: `Wika ng pagbabasa`,
  navAria: `Pangunahing navigation`,
  homeAria: `Bumalik sa DMI Calamba City home`,
  summaryAria: `Buod ng study`,
  takeawayAria: `Pangunahing takeaway ng study`,
  qrLinkAria: `Buksan ang Bible study na ito`,
  qrImageAlt: `QR code para sa Contending for Jesus in Our Lives Bible study`,
  coverLinkAria: `Simulan ang Contending for Jesus in Our Lives Bible study`,
  coverImageAlt: `Bible Study Guide: Dig Deep in God’s Presence — Contending for Jesus in Our Lives, Genesis 26`,
  eyebrow: `Bible Study · Genesis 26:17–33`,
  title: `Dig Deep in God’s Presence`,
  subtitle: `Contending for Jesus in Our Lives`,
  heroScripture: `<sup>17</sup> Kaya umalis doon si Isaac at nagkampo sa Valley of Gerar, at doon siya nanirahan. <sup>18</sup> Muling hinukay ni Isaac ang mga balon ng tubig na hinukay noong panahon ng kanyang amang si Abraham, na tinabunan ng mga Filisteo pagkamatay ni Abraham. Tinawag niya ang mga ito sa mga pangalang ibinigay ng kanyang ama. <sup>19</sup> Ngunit nang maghukay ang mga lingkod ni Isaac sa lambak at makakita roon ng balon ng bukal na tubig, <sup>20</sup> nakipagtalo ang mga pastol ng Gerar sa mga pastol ni Isaac at sinabi, “Amin ang tubig.” Kaya tinawag niya ang balon na Esek, dahil nakipagtalo sila sa kanya. <sup>21</sup> Naghukay sila ng isa pang balon, at pinag-awayan din iyon, kaya tinawag niya itong Sitnah. <sup>22</sup> Umalis siya roon at naghukay ng isa pang balon, at hindi na nila iyon pinag-awayan. Kaya tinawag niya itong Rehoboth at sinabi, “Ngayon ay binigyan tayo ng Panginoon ng maluwang na lugar, at mamumunga tayo sa lupain.”`,
  heroCitation: `Genesis 26:17–22 · salin para sa study`,
  themeLabel: `Tema`,
  theme: `Dahil si Jesus ang tunay na bukal ng buhay, patuloy nating nililinis at pinalalalim ang paglapit sa Kanya hanggang ang Kanyang buhay na tubig ay umapaw sa ating buhay at komunidad.`,
  keyTextsLabel: `Mga susing talata`,
  keyTexts: `Genesis 26:17–33<br />Awit 42:1<br />Filipos 4:6–7<br />1 Corinto 10:13<br />Juan 7:37–38`,
  timeLabel: `Oras`,
  time: `35–40 minuto`,
  presentationLabel: `Presentation`,
  presentationLink: `Buksan sa Canva <span aria-hidden="true">↗</span>`,
  serviceLabel: `Sunday service`,
  serviceUnavailable: `Walang hiwalay na YouTube link na ibinigay`,
  facebookLabel: `Facebook Live`,
  facebookLink: `Panoorin sa Facebook <span aria-hidden="true">↗</span>`,
  section01: `01 · Magsimula sa balon`,
  openingTitle: `Hindi tayo mabubuhay nang hiwalay sa Bukal`,
  openingLead: `Si Isaac ay dayuhan sa Gerar. Pinaalis siya sa sentro, ngunit saan man siya magpunta, naghukay siya—at muling hinukay ang mga balong tinabunan matapos mamatay si Abraham.`,
  openingBody1: `Hindi luxury ang balon para sa sambahayan, mga lingkod, at mga kawan ni Isaac. Ito ang kanilang access sa tubig na kailangan nila upang mabuhay. Ganoon din ang larawan ng ating spiritual life: ang balon ay hindi ang bukal; ito ang lugar kung saan tayo patuloy na sumasalok sa Diyos.`,
  openingBody2: `Si Jesus mismo ang tubig na nagbibigay-buhay. Ang personal na prayer, pagbabasa, pagninilay, pagsasaulo, at pagsunod sa Salita ang mga gawaing nagbubukas ng buhay natin sa Kanya. Kahit matagal na tayong Kristiyano, hindi tayo lalago sa lumang tubig lamang. Kailangan nating patuloy na lumapit sa Bukal.`,
  keyTruthLabel: `Susing katotohanan`,
  keyTruth: `Hindi si Jesus ang ipinaglalaban natin na parang kailangan Niya ng depensa; ipinaglalaban natin ang lugar Niya sa ating puso laban sa anumang gustong pumalit sa Kanya.`,
  discuss1Label: `Pag-usapan · 1`,
  discuss1: `Ano ang itinuturo ng larawan ng balon tungkol sa pagdepende kay Jesus? Sa kasalukuyan, saan ka aktuwal na sumasalok para sa lakas, satisfaction, at direction?`,
  section02: `02 · Alisin ang tumabon sa balon`,
  buriedTitle: `Ang uhaw kay Diyos ay humuhukay sa ilalim ng mga distraction`,
  buriedBody1: `Ipinapakita ng Awit 42 ang matinding pagnanais: kung paanong nauuhaw ang usa sa umaagos na tubig, gayon nananabik ang kaluluwa sa Diyos. Hindi ito casual interest. Ito ay pusong nagsasabing, “Panginoon, hindi ako mabubuhay nang wala Ka.”`,
  buriedBody2: `Ngunit maraming bagay ang maaaring tumabon sa ating paglapit kay Jesus: problemang paulit-ulit nating iniisip, kasalanang ayaw nating takasan, worldly desires, sobrang abala, mga ideolohiyang mas pinakikinggan kaysa Salita ng Diyos, at walang katapusang ingay mula sa social media at entertainment.`,
  buriedBody3: `Kapag anxious tayo, inaanyayahan tayong manalangin nang may pasasalamat at tanggapin ang kapayapaan ng Diyos. Kapag tinutukso, nagbibigay Siya ng way of escape na dapat nating piliin. Kapag nalilito, ang Kanyang Salita ang ilaw sa ating daan. Ang paghuhukay ay hindi pag-iwas sa problema; ito ay pagdadala ng buong buhay pabalik kay Jesus.`,
  keyVerse: `Susing talata · salin para sa study`,
  hungerVerse: `“Kung paanong nananabik ang usa sa umaagos na batis, gayon nananabik ang kaluluwa ko sa Iyo, O Diyos.”`,
  hungerCitation: `Awit 42:1 · salin para sa study`,
  discuss2Label: `Pag-usapan · 2`,
  discuss2: `Anong “lupa” ang kasalukuyang tumatabon sa balon mo—anxiety, kasalanan, busyness, maling boses, o distraction? Ano ang isang konkretong paraan para alisin ito ngayong linggo?`,
  section03: `03 · Patuloy na maghukay sa gitna ng opposition`,
  oppositionTitle: `Hindi huling salita ang Esek at Sitnah`,
  oppositionBody1: `Tinawag ni Isaac ang unang pinag-awayan na balon na <em>Esek</em>—contention. Tinawag niya ang sumunod na <em>Sitnah</em>—hostility, opposition, at accusation. May mga pagkakataong ang pinaghirapan natin ay aangkinin ng iba, o ang tapat na pagsunod ay sasalubungin ng conflict.`,
  oppositionBody2: `Hindi tumigil si Isaac, at hindi rin niya ginawang sentro ng buhay ang pakikipag-away. Nagpatuloy siyang humanap ng tubig. Sa parehong paraan, ang opposition ay hindi dahilan para putulin ang prayer, Salita, worship, at fellowship. Ito ang panahon para mas malalim na kumapit sa tunay na Bukal.`,
  oppositionBody3: `Ikinuwento ng preacher ang pagkakataong hindi niya ipinilit ang karapatan niya sa harap ng isang pagod at masungit na pulis matapos ang aksidente. Hindi ibig sabihin na hindi kailanman ipinagtatanggol ang tama. Kailangan ng karunungan. Ngunit may mga pagkakataong mas mabigat ang ating testimony kaysa sa panalo sa argumento.`,
  keyTruth2: `Keep digging—especially when opposition comes.`,
  discuss3Label: `Pag-usapan · 3`,
  discuss3: `Sa isang conflict na kinakaharap mo, ano ang mas pinangangalagaan mo—ang pagiging tama o ang testimony ni Jesus? Ano ang maaaring hitsura ng wisdom, truth, at restraint sa sitwasyong iyon?`,
  section04: `04 · Tanggapin ang lawak na ibinibigay ng Diyos`,
  provisionTitle: `Sa Rehoboth, Diyos ang binigyan ng papuri`,
  provisionBody1: `Sa ikatlong balon ay walang nakipagtalo. Tinawag iyon ni Isaac na <em>Rehoboth</em>—malawak na lugar o spaciousness. Hindi niya sinabi, “Tingnan ninyo ang nagawa ko.” Sinabi niya, “Binigyan tayo ng Panginoon ng lugar.” Ang Diyos ang Provider; ang balon ay Kanyang biyaya.`,
  provisionBody2: `Para tayong mga batang maraming laruan ngunit nag-aaway sa iisang hawak ng iba kapag iniisip nating kakaunti ang biyaya. Kumpara tayo, naiinggit, o ginagaya ang calling ng iba. Ngunit malawak ang biyaya ng Diyos. Hindi natin kailangang agawin ang gifting, ministry, o pagkilala ng kapwa.`,
  provisionBody3: `Bawat isa ay tinatawag na humukay nang malalim at kumonekta sa iisang Bukal. Sapat ang biyaya ni Cristo upang hubugin ang natatanging calling na ibinigay Niya sa bawat isa at gawin tayong fruitful kung saan Niya tayo inilagay.`,
  keyTruth3: `Hindi natin kailangang pag-awayan ang biyaya ng Diyos. May puwang Siya para sa bawat buhay na nakaugat kay Cristo.`,
  discuss4Label: `Pag-usapan · 4`,
  discuss4: `Saan ka natutuksong ikumpara ang calling o gifting mo sa iba? Paano ka inaanyayahan ng Rehoboth na magpasalamat, maghukay, at maging faithful sa puwang na ibinigay ng Diyos?`,
  section05: `05 · Unahin ang encounter bago ang panibagong paghuhukay`,
  beershebaTitle: `Altar, tent, at well`,
  beershebaBody1: `Sa Beersheba, unang nagpakita ang Panginoon kay Isaac at sinabi, “Huwag kang matakot, sapagkat kasama mo Ako.” Sumagot si Isaac sa pamamagitan ng pagtatayo ng altar, pagtawag sa pangalan ng Panginoon, at pagtatayo ng tolda. Pagkatapos, naghukay muli ang kanyang mga lingkod.`,
  beershebaBody2: `Mahalaga ang pagkakasunod: encounter, worship, settled presence, at pagkatapos ay work. Hindi tayo naghuhukay para pilitin ang Diyos na magbigay. Humuhukay tayo bilang tugon sa Diyos na lumapit, nagsalita, at nangakong sasama.`,
  beershebaBody3: `Ang pangalang Beersheba ay nag-uugnay sa well at oath. Para sa atin, ang tiyak na covenant ay hindi nakasalalay sa ating good works kundi sa grace ng Diyos na tinatanggap sa pananampalataya kay Jesus. May access tayo sa Bukal dahil binuksan ni Cristo ang daan.`,
  altarVerse: `<sup>24</sup> “Ako ang Diyos ni Abraham na iyong ama. Huwag kang matakot, sapagkat kasama mo Ako at pagpapalain kita.” <sup>25</sup> Kaya nagtayo siya roon ng altar, tumawag sa pangalan ng Panginoon, at nagtayo roon ng kanyang tolda. At doon naghukay ng balon ang mga lingkod ni Isaac.`,
  altarCitation: `Genesis 26:24–25 · salin para sa study`,
  discuss5Label: `Pag-usapan · 5`,
  discuss5: `Alin ang madalas mauna sa buhay mo—striving o encounter with God? Anong ritmo ng altar, tent, at well ang makatutulong para mamuhay ka mula sa grace sa halip na subukang kitain ito?`,
  section06: `06 · Hayaan ang balon na maging overflow`,
  overflowTitle: `Ang buhay na tubig ay hindi natatapos sa atin`,
  overflowBody1: `Ikinuwento sa sermon ang Moravian community—mga Christian refugee na hinati ng cultural at doctrinal differences. Sa halip na sumuko sa isa’t isa, hinanap nila ang Diyos sa prayer, Bible study, repentance, at renewed commitment na magmahal. Ang conflict ay humantong sa reconciliation at sama-samang pananalangin.`,
  overflowBody2: `Hindi sa kanila nagtapos ang renewal. Umabot ito sa mga anak, sa mga komunidad, at sa mission sa iba’t ibang lugar. Ito ang larawan ng “dig deep in His presence, into the overflow”: kapag tayo ay muling nakakonekta kay Jesus, ang Kanyang buhay sa atin ay nagiging pagpapala sa iba.`,
  overflowBody3: `Hindi lamang sinasabi ni Jesus na bibigyan Niya tayo ng sapat para makaraos. Inaanyayahan Niya ang nauuhaw na lumapit at uminom, at nangangako Siyang mula sa sumasampalataya ay dadaloy ang mga ilog ng buhay na tubig. Ang personal na well ay tinatawag na maging shared prayer, reconciliation, service, at mission.`,
  livingWaterVerse: `<sup>37</sup> “Kung may nauuhaw, lumapit siya sa Akin at uminom. <sup>38</sup> Ang sumasampalataya sa Akin, gaya ng sinabi ng Kasulatan, ‘Mula sa kanyang puso ay dadaloy ang mga ilog ng buhay na tubig.’”`,
  livingWaterCitation: `Juan 7:37–38 · salin para sa study`,
  discuss6Label: `Pag-usapan · 6`,
  discuss6: `Anong relasyon o grupo ang nangangailangan ng repentance, reconciliation, at sama-samang prayer? Sino ang maaaring abutin ng overflow kung magsisimula kayong muling sumalok kay Jesus nang sama-sama?`,
  section07: `07 · Tumugon`,
  responseTitle: `Alisin ang bara. Lumapit sa Bukal. Patuloy na maghukay.`,
  responseBody1: `Tinatawag tayo ni Jesus na lumapit nang nauuhaw, hindi magkunwaring sapat na tayo. Maaari nating pangalanan ang tumabon sa balon at dalhin iyon sa Kanya nang may repentance, tiwala, at pag-asang tutulungan Niya tayo.`,
  responseBody2: `Hindi kailangang manatiling pribado ang paghuhukay. Anyayahan ang iba sa rhythm ng prayer at Salita, ayusin ang kailangang ayusin, at hayaan ang natanggap na biyaya na dumaloy sa tahanan, church, school, workplace, at city.`,
  responseStepLabel: `Tumugon`,
  responseClear: `Pangalanan at isuko kay Jesus ang isang bagay na tumatabon sa balon mo.`,
  responseDraw: `Magtakda ng araw-araw na oras ngayong linggo para sa prayer, Scripture, meditation, at obedience.`,
  responseWitness: `Sa isang conflict, piliin ang truth at isang hakbang na magpoprotekta sa testimony ni Jesus.`,
  responseOverflow: `Anyayahan ang dalawa o tatlong tao sa regular na prayer at isang konkretong gawain ng reconciliation, service, o mission.`,
  promiseLabel: `Ang pangako`,
  promise: `“Kung may nauuhaw, lumapit siya sa Akin at uminom. Ang sumasampalataya sa Akin… mula sa kanyang puso ay dadaloy ang mga ilog ng buhay na tubig.” — Juan 7:37–38`,
  section08: `08 · Manalangin`,
  prayerTitle: `Isang panalangin para sa muling binuksang balon`,
  prayer1: `Panginoong Jesus, Ikaw lamang ang tunay na Bukal ng buhay. Patawarin Mo kami sa mga panahong hinayaan naming matabunan ng anxiety, kasalanan, busyness, maling boses, at distractions ang aming paglapit sa Iyo. Gisingin Mo muli ang aming hunger at thirst para sa Iyo.`,
  prayer2: `Bigyan Mo kami ng grace na patuloy na maghukay kapag may contention, hostility, at accusation. Turuan Mo kaming magsalita ng katotohanan nang may karunungan, isuko ang karapatan kapag iyon ang tapat na tugon, at pahalagahan ang testimony Mo nang higit sa aming pride.`,
  prayer3: `Salamat dahil sapat at malawak ang Iyong biyaya. Itatag Mo ang aming altar, tolda, at balon sa presensya Mo. Paglapitin Mo ang mga nahati, buuin Mo kami sa prayer at Salita, at hayaang dumaloy ang Iyong buhay na tubig mula sa amin patungo sa aming pamilya, church, city, at mga bansa. Sa pangalan ni Jesus, Amen.`,
  takeawayLabel: `Dalhin mo ito`,
  takeaway: `Si Jesus ang Bukal na hindi nauubos. Alisin ang tumabon, patuloy na maghukay sa gitna ng opposition, at sumalok hanggang ang Kanyang buhay sa iyo ay umapaw sa iba.`,
  shareLabel: `Ibahagi ang study`,
  shareTitle: `Buksan sa ibang device`,
  shareBody: `I-scan o i-download ang QR code para direktang makabalik sa Bible study na ito.`,
  downloadQr: `I-download ang QR code`,
  scriptureNotice: `Ang English Scripture quotations na may markang ESV ay mula sa ESV® Bible (The Holy Bible, English Standard Version®), © 2001 by Crossway, isang publishing ministry ng Good News Publishers. Ginamit nang may pahintulot. All rights reserved. Ang Taglish quotations ay mga salin para sa study.`,
  footerTagline: `Nagkakatipon kay Jesus. Hinuhubog ng Kanyang Salita.`,
};
