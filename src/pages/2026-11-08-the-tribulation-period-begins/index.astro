const translations = {
  languageLabel: 'Wika',
  languageAriaLabel: 'Wika ng pagbabasa',
  navAria: 'Pangunahing navigation',
  homeAria: 'Bumalik sa DMI Calamba City home',
  date: '8 Nobyembre 2026',
  coverLinkAria: 'Simulan ang The Tribulation Period Begins Bible study',
  coverImageAlt: 'Unang Canva slide ng The Tribulation Period Begins: gintong pamagat, bukas na mga aklat, at krus sa madilim na background',
  eyebrow: 'Bible Study · Pahayag 6–7',
  title: 'The Tribulation Period Begins',
  subtitle: 'Walang pagsubok ang makakaagaw sa ating walang hanggang pag-asa kay Cristo',
  hero: 'Ang Kordero ang magiging Pastol nila, at papahirin ng Diyos ang bawat luha sa kanilang mga mata.',
  heroCitation: 'Pahayag 7:17 · salin para sa study',
  summaryAria: 'Buod ng Bible study',
  themeLabel: 'Tema',
  theme: 'Ang Diyos ay naghahari kahit gumuho ang mga inaasahan natin sa mundo. Ang mga tinubos ng Kordero ay may walang hanggang pag-asang hindi kayang agawin ng pagdurusa.',
  keyLabel: 'Mga susing talata',
  key: 'Pahayag 6:1–17 · Ang unang anim na selyo<br />Pahayag 7:1–17 · Ang bayan ng Diyos<br />Pahayag 19:11–16 · Ang tapat at tunay na Hari',
  timeLabel: 'Oras',
  time: '40–50 minuto',
  presentation: 'Presentation',
  presentationLink: 'Buksan sa Canva <span aria-hidden="true">↗</span>',
  service: 'Sunday service',
  serviceLink: 'Panoorin ang pangangaral sa YouTube <span aria-hidden="true">↗</span>',
