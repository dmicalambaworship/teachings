  removeAshes: 'Alisin ang abo',
  removeAshesBody: 'Kasalanang hindi ipinagtapat, bitterness, lihim na compromise, pride, mapanirang habits, at spiritual apathy.',
  addWood: 'Magdagdag ng sariwang kahoy',
