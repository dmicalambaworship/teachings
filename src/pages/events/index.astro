---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';

const base = import.meta.env.BASE_URL;
const logoPath = `${base}dmi-logo.jpg`;
const anniversaryPath = `${base}events/20260916-dmi-18th-anniversary/`;
---

<BaseLayout
  title="Events | DMI Calamba City"
  description="Events from DMI Calamba City."
  bodyClass="events-index-page"
  socialImage={`${base}dmi-calamba-social-preview.jpg`}
  socialImageAlt="DMI Calamba City events"
  socialImageWidth={1280}
  socialImageHeight={720}
>
  <header class="songs-hero events-index-hero">
    <nav class="study-nav" aria-label="Primary navigation">
      <a class="brand-lockup" href={base} aria-label="Return to DMI Calamba City home"><img src={logoPath} width="900" height="900" alt="DMI church logo" /><span>Calamba City</span></a>
    </nav>
    <div class="songs-hero-copy">
      <p class="eyebrow">Celebrations and gatherings</p>
      <h1>Events</h1>
      <p>Moments when the DMI Calamba City family gathers to remember, celebrate, and give thanks.</p>
    </div>
  </header>

  <main class="events-index-content">
    <header class="events-index-intro">
      <div><p class="section-number">Latest event</p><h2>Remember. Celebrate. Give thanks.</h2></div>
      <p>Watch and revisit special gatherings from DMI Calamba City—captured in video and shared for the whole church family.</p>
    </header>

    <ol class="events-list">
      <li>
        <a href={anniversaryPath}>
          <span class="events-list-meta">16 September 2026 · 18th Anniversary</span>
          <h2>18 Years of God’s Faithfulness</h2>
          <p>A two-day celebration with a Leaders Retreat, a church service, and team building. Watch the full video.</p>
          <span class="events-list-action">Watch the celebration <span aria-hidden="true">↗</span></span>
        </a>
      </li>
    </ol>
  </main>

  <footer class="site-footer"><a href={base}>DMI Calamba City</a><div class="site-footer-actions"><span>Gathered around Jesus. Formed by his Word.</span><SocialLinks /></div></footer>
</BaseLayout>